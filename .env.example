# Copy these names into apps/web/.env.local for local development.
# Original AccessPath audit project (optional; only for saved audit scans).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Separate AccessPath Finance project for /login and /account.
NEXT_PUBLIC_FINANCE_SUPABASE_URL=
NEXT_PUBLIC_FINANCE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after the Wikipedia migration and Railway worker deployment.
NEXT_PUBLIC_WIKIPEDIA_SCAN_ENABLED=false
